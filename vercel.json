{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/((?!en(?:/|$)|pt-br(?:/|$)|_astro(?:/|$)|fonts(?:/|$)|.*\\.[^/]+$).*)$",
      "has": [
        {
          "type": "cookie",
          "key": "portfolio-language",
          "value": "pt-br"
        }
      ],
      "headers": {
        "Location": "/pt-br/$1",
        "Cache-Control": "private, no-store",
        "Vary": "Cookie, x-vercel-ip-country"
      },
      "status": 307
    },
    {
      "src": "^/((?!en(?:/|$)|pt-br(?:/|$)|_astro(?:/|$)|fonts(?:/|$)|.*\\.[^/]+$).*)$",
      "has": [
        {
          "type": "cookie",
          "key": "portfolio-language",
          "value": "en"
        }
      ],
      "headers": {
        "Location": "/en/$1",
        "Cache-Control": "private, no-store",
        "Vary": "Cookie, x-vercel-ip-country"
      },
      "status": 307
    },
    {
      "src": "^/((?!en(?:/|$)|pt-br(?:/|$)|_astro(?:/|$)|fonts(?:/|$)|.*\\.[^/]+$).*)$",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "BR"
        }
      ],
      "headers": {
        "Location": "/pt-br/$1",
        "Cache-Control": "private, no-store",
        "Vary": "Cookie, x-vercel-ip-country"
      },
      "status": 307
    },
    {
      "src": "^/((?!en(?:/|$)|pt-br(?:/|$)|_astro(?:/|$)|fonts(?:/|$)|.*\\.[^/]+$).*)$",
      "headers": {
        "Location": "/en/$1",
        "Cache-Control": "private, no-store",
        "Vary": "Cookie, x-vercel-ip-country"
      },
      "status": 307
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/pt-br/.*",
      "dest": "/pt-br/404/index.html",
      "status": 404
    },
    {
      "src": "/en/.*",
      "dest": "/en/404/index.html",
      "status": 404
    }
  ]
}
