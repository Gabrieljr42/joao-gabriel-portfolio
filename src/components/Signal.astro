---
import { getContent } from '../i18n/content';
import type { Locale } from '../i18n/routing';
interface Props { locale: Locale; }
const { practices, ui } = getContent(Astro.props.locale);
import Arrow from './Arrow.astro';
// Code-native art: three engineering disciplines, woven into one system.
const strands = Array.from({ length: 100 }, (_, i) => {
  const offset = i / 99;
  const points = Array.from({ length: 241 }, (_, j) => {
    const t = j / 240 * Math.PI * 2;
    const v = offset * Math.PI * 2;
    const r = 150 + 62 * Math.cos(v + t * 1.5);
    const x = r * Math.cos(t), y = r * Math.sin(t), z = 62 * Math.sin(v + t * 1.5);
    const y1 = y * Math.cos(.9) - z * Math.sin(.9);
    const z1 = y * Math.sin(.9) + z * Math.cos(.9);
    const x2 = x * Math.cos(-.4) + z1 * Math.sin(-.4);
    return `${j === 0 ? 'M' : 'L'}${(300 + x2 * 1.23).toFixed(2)},${(292 + y1 * 1.23).toFixed(2)}`;
  }).join(' ');
  return { path: points, group: i % 3, opacity: .25 + Math.sin(offset * Math.PI) * .55 };
});
---
<div class="signal" data-signal data-practices={JSON.stringify(practices)} data-trace-hint={ui.traceHint}>
  <div class="signal-visual">
  <svg viewBox="0 0 600 600" class="signal-svg" fill="none" aria-hidden="true">
    <defs><linearGradient id="copper" x1="80" y1="500" x2="450" y2="80" gradientUnits="userSpaceOnUse"><stop stop-color="#63554a"/><stop offset=".36" stop-color="#ce997b"/><stop offset=".62" stop-color="#f3d5bd"/><stop offset="1" stop-color="#e6a27e"/></linearGradient></defs>
    <g data-signal-form>{strands.map(s => <path d={s.path} stroke="url(#copper)" stroke-width=".75" opacity={s.opacity} data-thread={s.group} />)}</g>
    <g class="signal-guide"><path data-trace-segment d="M300 130 C430 70 550 180 500 310"/><path data-trace-segment d="M500 310 C455 450 290 510 160 430"/><circle cx="300" cy="130" r="4"/><circle cx="500" cy="310" r="4"/><circle cx="160" cy="430" r="4"/></g>
    <circle data-signal-packet cx="300" cy="130" r="6" fill="#f3d5bd" />
  </svg>
  <ol class="signal-nodes" aria-label={ui.flowLabel}>{ui.flow.map((label, i) => <li data-signal-node={i}><span>{label}</span><strong data-node-label>{practices[0].nodes[i]}</strong></li>)}</ol>
  </div>
  <div class="signal-walkthrough"><button class="trace-button" data-trace><span data-trace-label>{practices[0].trace}</span><Arrow /></button><p data-trace-status aria-live="polite">{ui.traceHint}</p></div>
</div>
