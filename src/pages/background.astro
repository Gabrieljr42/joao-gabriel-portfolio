---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import { site, background } from '../data/site';
---
<Base title="Experience, education & credentials" description="João Gabriel’s engineering background, education at IFMG and PUC-Rio, and professional learning credentials.">
  <div class="background shell">
    <section class="background-hero" aria-labelledby="background-title">
      <a class="text-link" href="/#about"><span>Back to the introduction</span><Arrow /></a>
      <h1 id="background-title">{background.title[0]}<br /><span>{background.title[1]}</span></h1>
      <div class="background-deck"><p>{background.intro}</p><span>{background.location}</span></div>
      <nav class="background-index" aria-label="Background sections"><a href="#experience">Experience<Arrow direction="down" /></a><a href="#education">Education<Arrow direction="down" /></a><a href="#credentials">Credentials<Arrow direction="down" /></a></nav>
    </section>
    <section class="background-section" id="experience" aria-labelledby="experience-title">
      <div class="background-label"><p class="section-label">In practice</p><h2 id="experience-title">The work<br />behind the work.</h2></div>
      <div class="experience-list">{background.experience.map(job => <article><p class="period">{job.period}</p><h3>{job.company}</h3><p class="job-role">{job.role}</p><p class="muted">{job.text}</p></article>)}</div>
    </section>
    <section class="background-section education-section" id="education" aria-labelledby="education-title">
      <div class="background-label"><p class="section-label">Formal education</p><h2 id="education-title">A foundation.<br />A new direction.</h2></div>
      <div class="education-list">{background.education.map((education, i) => <article class={i === 0 ? 'education-current' : ''}><div class="education-meta"><span>{education.level}</span><span class="education-status">{education.status}</span></div><p class="institution">{education.institution}</p><h3>{education.title}</h3><p class="period">{education.period}</p><p class="muted">{education.text}</p></article>)}</div>
    </section>
    <section class="credentials-section" id="credentials" aria-labelledby="credentials-title">
      <div class="section-top"><div><p class="section-label">Professional learning</p><h2 id="credentials-title">Keep making connections.</h2></div><p class="section-intro">Courses completed. Ideas carried forward.</p></div>
      <ul class="credential-list">{background.certificates.map(certificate => <li><a href={`https://cursos.alura.com.br/certificate/${certificate.id}`} target="_blank" rel="noopener noreferrer"><div class="credential-meta"><span>{certificate.issuer}</span><time>{certificate.date}</time></div><div><h3 lang="pt-BR">{certificate.title}</h3><p>{certificate.description}</p></div><span class="credential-action">View credential<Arrow /></span></a></li>)}</ul>
      <div class="background-source"><p>{background.note}</p><a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer"><span>View LinkedIn profile</span><Arrow /></a></div>
    </section>
    <a class="next-project" href="/#work"><span>Put into practice</span><strong>Explore the projects.</strong><Arrow /></a>
  </div>
  <Footer slot="footer" compact />
</Base>
