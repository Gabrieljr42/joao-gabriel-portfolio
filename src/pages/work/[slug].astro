---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import Arrow from '../../components/Arrow.astro';
import Pipeline from '../../components/Pipeline.astro';
import { site, projects } from '../../data/site';
export function getStaticPaths() { return projects.map((project, i) => ({ params: { slug: project.slug }, props: { project, next: projects[(i + 1) % projects.length] } })); }
const { project, next } = Astro.props;
---
<Base title={project.title} description={project.description}>
  <article class="case shell">
    <div class="case-top"><a class="text-link" href="/#work"><Arrow direction="left" /><span>{site.labels.allWork}</span></a><p class="muted">{project.category}</p></div>
    <header class="case-heading"><h1>{project.title}</h1><div class="case-deck"><p>{project.description}</p><dl><div><dt>{site.labels.role}</dt><dd>{project.scope}</dd></div><div><dt>{site.labels.stack}</dt><dd>{project.tags.join(', ')}</dd></div></dl></div></header>
    <nav class="case-route" aria-label="Follow the system from input to outcome">{project.flow.map((stage, i) => <a href={['#context', '#decisions', '#outcome'][i]}><span class="route-node" aria-hidden="true"></span><span><small>{['Input', 'System', 'Output'][i]}</small>{stage}</span></a>)}</nav>
    <figure class={`case-cover ${project.tint}`}><Image src={project.cover} alt={project.alt} widths={[600, 1000, 1500, 2000]} sizes="92vw" width={1600} format="webp" quality={88} fetchpriority="high" loading="eager" /><figcaption>{project.category} / {project.type}</figcaption><a class="case-image-link text-link" href={project.cover.src} target="_blank" rel="noopener noreferrer"><span>{site.labels.fullImage}</span><Arrow /></a></figure>
    <section class="case-section" id="context"><h2>{site.labels.context}</h2><div class="case-prose"><p class="large-copy">{project.context}</p><p>{project.idea}</p></div></section>
    <section class="case-section" id="decisions"><h2>{site.labels.decisions}</h2><div class="decision-list">{project.decisions.map((decision, i) => <div><span class="decision-index">{String(i + 1).padStart(2, '0')}</span><h3>{decision.title}</h3><p>{decision.text}</p></div>)}</div></section>
    {project.slug === 'observador' ? <div class="case-gallery"><Pipeline /></div> : <div class="case-gallery">{project.media.map(media => <figure><Image src={media.image} alt={media.alt} widths={[600, 1000, 1600]} sizes="92vw" width={1600} format="webp" quality={87} loading="lazy" /><figcaption>{media.caption}</figcaption><a class="case-image-link text-link" href={media.image.src} target="_blank" rel="noopener noreferrer"><span>{site.labels.fullImage}</span><Arrow /></a></figure>)}</div>}
    <section class="case-section case-outcome" id="outcome"><h2>{site.labels.status}</h2><div class="case-prose"><p class="large-copy">{project.outcome}</p><a class="button" href={project.href} target="_blank" rel="noopener noreferrer"><span>{site.labels.source}</span><Arrow /></a></div></section>
    <a class="next-project" href={`/work/${next.slug}/`}><span>{site.labels.next}</span><strong>{next.title}</strong><Arrow /></a>
  </article>
  <Footer slot="footer" compact />
</Base>
