---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import Signal from '../components/Signal.astro';
import { getContent } from '../i18n/content';
import { localizedPath, type Locale } from '../i18n/routing';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { site, projects, practices, contributions, ui } = getContent(locale);
const href = (path: string) => localizedPath(path, locale);
---
<Base locale={locale}>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-content"><p class="hero-label"><span class="status-dot" aria-hidden="true"></span>{site.hero.since}</p><h1 id="hero-title">{site.hero.first}<br /><span>{site.hero.second}</span></h1><p class="hero-intro">{site.hero.intro}</p><a class="button" href="#work"><span>{site.hero.cta}</span><Arrow direction="down" /></a></div>
    <div class="hero-art"><Signal locale={locale} /></div>
    <div class="hero-bottom"><span class="location"><span aria-hidden="true">↳</span>{site.hero.location}<span class="location-zone">{ui.acrossStack}</span></span><div class="practice-switcher" role="group" aria-label={ui.practiceLabel}>{practices.map((p, i) => <button data-practice={i} aria-pressed={i === 0}><span class="practice-node" aria-hidden="true"></span>{p.title}</button>)}</div></div>
    <div class="practice-caption" aria-live="polite"><span data-practice-label>{practices[0].label}</span><a data-practice-project href={practices[0].href}>{practices[0].project}<Arrow /></a></div>
  </section>
  <section class="work shell" id="work" aria-labelledby="work-title">
    <div class="section-top"><div><p class="section-label">{site.work.label}<span class="count">04</span></p><h2 id="work-title">{site.work.title}</h2></div><p class="section-intro">{site.work.intro.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</p></div>
    <div class="project-grid">{projects.map((project, i) => <article class={`project project-${i}`}><a class={`project-image ${project.tint}`} href={href(`/work/${project.slug}/`)} aria-label={`${project.category}. ${site.labels.viewCase}: ${project.title}`}><div class="project-media"><Image src={project.cover} alt={project.alt} widths={[480, 760, 1100]} sizes="(max-width: 700px) 90vw, 46vw" width={1100} format="webp" quality={85} loading="lazy" /></div><span class="image-label">{project.category}</span><span class="project-open"><Arrow /></span></a><div class="project-info"><div><p class="project-summary">{project.summary}</p><h3><a href={href(`/work/${project.slug}/`)}>{project.title}<Arrow /></a></h3></div><span class="project-year">↗</span></div><div class="tags">{project.tags.slice(0, 3).map(tag => <span>{tag}</span>)}</div></article>)}</div>
    <a class="text-link repositories" href={`${site.github}?tab=repositories`} target="_blank" rel="noopener noreferrer"><span>{site.work.all}</span><Arrow /></a>
  </section>
  <section class="about shell" id="about" aria-labelledby="about-title">
    <div class="about-opening"><h2 id="about-title">{site.about.title.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2><div class="about-copy"><p class="large-copy">{site.about.intro}</p><p class="muted">{site.about.body}</p><a class="text-link" href={href('/background/')}><span>{ui.backgroundLink}</span><Arrow /></a></div></div>
    <div class="practice-list">{site.about.practices.map((practice, i) => <div class="practice-row"><span class="row-symbol" aria-hidden="true">{['⌘', '✳', '↗'][i]}</span><h3>{practice.name}</h3><div><p>{practice.detail}</p><p class="practice-tools">{practice.tools}</p></div></div>)}</div>
    <div class="opensource"><div><h2>{site.about.openSource}</h2><p class="muted">{site.about.openIntro}</p><a class="text-link" href="https://github.com/pulls?q=is%3Apr+author%3AGabrieljr42" target="_blank" rel="noopener noreferrer"><span>{ui.contributions}</span><Arrow /></a></div><ul class="contribution-list">{contributions.map(c => <li><a href={c.href} target="_blank" rel="noopener noreferrer"><span class="contribution-name">{c.name}<span>{c.ecosystem}</span></span><span class="contribution-detail">{c.title}</span><span class="contribution-ref">{c.reference}<Arrow /></span></a></li>)}</ul></div>
  </section>
  <Footer locale={locale} slot="footer" />
</Base>
